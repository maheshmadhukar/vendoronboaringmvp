// Vendor Onboarding Portal — data model
// NOTE: status/role fields are kept as Strings (allowed values documented in
// lib/constants.ts) rather than native Postgres enums — a deliberate choice to
// keep lib/constants.ts the single source of truth and avoid churn. Converting
// to native enums is an optional future cleanup.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Department {
  id                 String   @id @default(cuid())
  key                String   @unique // HR | LEGAL | FINANCE | PROCUREMENT
  name               String
  slaDays            Int      @default(5)
  managerId          String?
  users              User[]   @relation("DeptMembers")
  reviews            DeptReview[]
  createdAt          DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  authUserId   String?  @unique // Supabase auth.users id — the identity link
  role         String   // ADMIN | DEPT | VENDOR
  active       Boolean  @default(true)
  departmentId String?
  department   Department? @relation("DeptMembers", fields: [departmentId], references: [id])
  vendorId     String?  @unique
  vendor       Vendor?  @relation("VendorAccount", fields: [vendorId], references: [id])
  createdAt    DateTime @default(now())

  createdVendors Vendor[]      @relation("VendorCreatedBy")
  notifications  Notification[]
  comments       Comment[]
  auditLogs      AuditLog[]

  @@index([departmentId])
}

model Vendor {
  id            String   @id @default(cuid())
  name          String
  legalName     String?
  address       String?
  phone         String?
  bankAccount   String?
  contactPerson String?
  gstin         String?
  turnover      Float?
  companyEmail  String?
  category      String?
  valueAmount   Float?   // contract value, for analytics
  status        String   @default("INVITED")
  // INVITED | DRAFT | SUBMITTED | IN_REVIEW | CHANGES_REQUESTED |
  // HALTED | DEPT_APPROVED | FINAL_PENDING | ONBOARDED | REJECTED
  haltReason    String?
  aiReviewEnabled Boolean @default(false)
  createdById   String?
  createdBy     User?    @relation("VendorCreatedBy", fields: [createdById], references: [id])
  account       User?    @relation("VendorAccount")
  registeredAt         DateTime? // invite consumed / vendor account activated
  onboardingStartedAt  DateTime? // first business-details save or first document upload
  submittedAt   DateTime?
  onboardedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  documents   Document[]
  deptReviews DeptReview[]
  comments    Comment[]
  buyerDocs   VendorBuyerDoc[]
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  token       String    @unique
  vendorId    String?
  createdById String?
  role        String    @default("VENDOR")
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model DocumentType {
  id              String  @id @default(cuid())
  key             String  @unique
  name            String
  departmentKey   String  // routing: HR | LEGAL | FINANCE | PROCUREMENT
  acceptedFormats String  @default("pdf,doc") // csv
  maxSizeMb       Int     @default(5)
  active          Boolean @default(true)
  order           Int     @default(0)
  helperText      String?
  documents       Document[]
}

model Document {
  id             String   @id @default(cuid())
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])
  filename       String?
  storedPath     String?
  sizeKb         Int?
  status         String   @default("PENDING") // PENDING | SUBMITTED | APPROVED | REJECTED | CHANGES_REQUESTED
  reviewNote     String?
  rejectionReason String? // categorized reason on reject/changes — see REJECTION_REASON in lib/constants.ts
  revisionCount  Int      @default(0) // number of resubmission cycles for this document
  uploadedAt     DateTime?
  updatedAt      DateTime @updatedAt

  @@index([vendorId])
}

model DeptReview {
  id           String   @id @default(cuid())
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED | CHANGES_REQUESTED
  decidedById  String?
  decidedAt    DateTime? // when this review reached a terminal (approved/rejected) decision
  comment      String?
  slaStartedAt DateTime?
  slaDueAt     DateTime?
  slaPausedAt  DateTime?
  pausedMs     Int      @default(0)
  slaState     String   @default("PENDING") // PENDING | RUNNING | PAUSED | MET | BREACHED
  everBreached Boolean  @default(false) // sticky: true once this review has ever missed its SLA, even after it later resolves
  slaReminderSentAt DateTime? // set once an amber-zone reminder has been sent to the dept manager, to avoid re-notifying
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([vendorId, departmentId])
  @@index([departmentId])
}

model Comment {
  id           String   @id @default(cuid())
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id])
  departmentId String?
  documentId   String?
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  body         String
  kind         String   @default("NOTE") // REJECT | CLARIFICATION | RESUBMIT | NOTE | APPROVE
  sectionIndex Int?     // which doc-content section (rich types only) this comment refers to
  createdAt    DateTime @default(now())

  @@index([vendorId])
  @@index([documentId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  kind      String   @default("INFO")
  vendorId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Config {
  id                    Int     @id @default(1)
  slaDaysDefault        Int     @default(5)
  cutoffHour            Int     @default(14)
  finalApprovalRequired Boolean @default(true)
  aiReviewDefault       Boolean @default(false)
  notifyVendorOnStatus  Boolean @default(true)
  notifyDeptOnSla       Boolean @default(true)
  notifyDeptOnResubmit  Boolean @default(true)
}

model BuyerDocTemplate {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  departmentKey String   // routing dropdown value; not used for access control in this scope
  active        Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  filename      String?
  storedPath    String?
  sizeKb        Int?
  uploadedAt    DateTime?
  vendorDocs    VendorBuyerDoc[]
}

/** A buyer document template attached to a specific vendor (created at invite time). */
model VendorBuyerDoc {
  id         String   @id @default(cuid())
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  templateId String
  template   BuyerDocTemplate @relation(fields: [templateId], references: [id])
  createdAt  DateTime @default(now())
  signedAt     DateTime?
  signedByName String?

  @@unique([vendorId, templateId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  meta       String?
  createdAt  DateTime @default(now())

  @@index([targetId])
}
