DATABASE_URL="file:./dev.db"
# Only needed when DATABASE_URL points at a remote Turso database (libsql://...).
# Leave unset for local file-based dev.
DATABASE_AUTH_TOKEN=
# Any string >= 32 chars. Change in production.
SESSION_SECRET="dev_only_change_me_vms_onboarding_super_secret_key_32c+"
# Shows a "Switch persona" control (top-right, admin-only) that swaps the
# session between demo accounts with no password check. Demo/staging only —
# leave unset in any real deployment.
# DEMO_MODE=true
